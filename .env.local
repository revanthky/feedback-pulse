# Local testing environment variables for Feedback Pulse
# NOT used by app code directly except via os.environ reads in app.py.
# docker-compose.yml maps container ports to these local host ports.

PG_HOST=localhost
PG_PORT=5433
PG_DB=feedback
PG_USER=feedback
PG_PASSWORD=feedback

MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=feedback
MINIO_SECURE=false

LLM_BASE_URL=
LLM_TOKEN=
LLM_MODEL=
